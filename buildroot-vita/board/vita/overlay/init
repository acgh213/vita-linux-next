#!/bin/sh
# /init -- initramfs PID 1 for the Vita/PSTV persistent-root boot.
#
# Replaces the stock Buildroot init. Its job is to decide, before handing over,
# whether to boot the persistent Debian root or stay in rescue -- and to make
# that decision from evidence the PREVIOUS attempt left behind.
#
# WHY THIS SHAPE
# --------------
# switch_root EXECS the new PID 1. There is no supervision, no return, no
# handler. If the new root panics, this script no longer exists to react. So
# every recovery decision happens HERE, before the exec, or it never happens.
#
# RESCUE IS THIS INITRAMFS.
# We do not build a separate rescue root. The initramfs we are already running
# is boot-proven, brings up wifi and SSH, and is the environment every previous
# session used. "Boot rescue" therefore means "do not switch_root" -- the
# cheapest and most reliable fallback available, and one that cannot itself be
# broken by a bad Debian image.
#
# FAILURE POLICY
# --------------
# Every failure path below falls through to rescue. Not one of them aborts the
# boot. A console that comes up in the old initramfs is a console you can SSH
# into and fix; a console that panics in a half-mounted root is a trip to the
# card reader.

PATH=/sbin:/usr/sbin:/bin:/usr/bin

CARD_MNT=/mnt/vita-card
NEWROOT=/mnt/newroot
ROOT_IMAGE_NAME=debian-trial.img
SELECT_ROOT=/usr/share/vita-boot/select-root
LOOP_DEV=/dev/loop7          # high number: the toolkit owns loop0/loop1

# --- early mounts (stock behaviour, preserved) -------------------------------
/bin/mount -t devtmpfs devtmpfs /dev 2>/dev/null
/bin/mount -t proc proc /proc 2>/dev/null
/bin/mount -t sysfs sysfs /sys 2>/dev/null

if (exec 0</dev/console) 2>/dev/null; then
    exec 0</dev/console
    exec 1>/dev/console
    exec 2>/dev/console
fi

log() {
    echo "[boot] $*"
    [ -w /dev/tty0 ] && echo "[boot] $*" > /dev/tty0 2>/dev/null
}

rescue() {
    log "RESCUE: $*"
    log "staying in the initramfs; SSH will come up as usual"
    exec /sbin/init
}

log "=== persistent-root selection ==="

# --- find the card -----------------------------------------------------------
# Match by CONTENT, not by name. SDIF1 defers behind the syscon and the game
# card has already renumbered mmcblk1 -> mmcblk2 once in this project's history.
# Never hardcode the number.
find_card() {
    for d in /dev/mmcblk*p1; do
        [ -b "$d" ] || continue
        case "$d" in
            /dev/mmcblk0p1) continue ;;   # internal eMMC, never the game card
        esac
        case "$(blkid -o value -s TYPE "$d" 2>/dev/null)" in
            exfat|vfat) echo "$d"; return 0 ;;
        esac
    done
    return 1
}

# Enumeration time is VARIABLE: measured 5.576 s on one boot and 155.6 s on the
# next, with nothing logged in between and no command timeouts. Sampling once
# at ~5 s misses the card most of the time -- that mistake previously produced
# a false "the hardware is dead" conclusion. So wait, but bound the wait.
CARD_WAIT=${VITA_CARD_WAIT:-90}
i=0
while [ $i -lt "$CARD_WAIT" ]; do
    CARD_DEV=$(find_card) && break
    sleep 1
    i=$((i + 1))
    [ $((i % 15)) -eq 0 ] && log "waiting for card... ${i}s"
done

[ -n "${CARD_DEV:-}" ] || rescue "no game card after ${CARD_WAIT}s"
log "card: $CARD_DEV (after ${i}s)"

mkdir -p "$CARD_MNT"
mount -t exfat -o rw,noatime "$CARD_DEV" "$CARD_MNT" 2>/dev/null \
  || mount -o rw,noatime "$CARD_DEV" "$CARD_MNT" 2>/dev/null \
  || rescue "card present but would not mount"

# --- the decision ------------------------------------------------------------
# select-root reads the boot-attempt record and the operator override. It is
# the only thing that gets to choose, and it fails closed to rescue.
if [ -x "$SELECT_ROOT" ]; then
    CHOICE=$(CARD_MNT="$CARD_MNT" "$SELECT_ROOT" 2>/dev/null)
else
    rescue "select-root missing from the initramfs"
fi

log "selection: ${CHOICE:-<none>}"
[ "$CHOICE" = normal ] || rescue "selector chose ${CHOICE:-rescue}"

# From here on select-root has already written an 'opened' record and synced it.
# If we die past this point, the next boot sees an unconfirmed attempt. That is
# the intended behaviour, not a leak.

ROOT_IMAGE="$CARD_MNT/$ROOT_IMAGE_NAME"
[ -f "$ROOT_IMAGE" ] || rescue "root image $ROOT_IMAGE_NAME not on card"

# --- attach and check the root image ----------------------------------------
losetup -d "$LOOP_DEV" 2>/dev/null
losetup "$LOOP_DEV" "$ROOT_IMAGE" 2>/dev/null || rescue "losetup failed"

# Check before mounting rw. A dirty ext4 mounted rw replays a journal we have
# not inspected; on removable media that is how a bad shutdown becomes a bad
# filesystem. -p fixes only what is unambiguously safe.
if command -v e2fsck >/dev/null 2>&1; then
    e2fsck -p "$LOOP_DEV" >/dev/null 2>&1
    rc=$?
    # 0 = clean, 1 = errors corrected. >=2 means do not trust it.
    if [ $rc -ge 2 ]; then
        losetup -d "$LOOP_DEV" 2>/dev/null
        rescue "e2fsck returned $rc on the root image"
    fi
    [ $rc -eq 1 ] && log "e2fsck corrected errors"
fi

mkdir -p "$NEWROOT"
mount -t ext4 -o rw,noatime,errors=remount-ro "$LOOP_DEV" "$NEWROOT" 2>/dev/null \
  || { losetup -d "$LOOP_DEV" 2>/dev/null; rescue "could not mount the root image"; }

# Sanity: is this actually a root filesystem? A successful mount of the wrong
# image is worse than a failed one, because switch_root would exec into nothing.
[ -x "$NEWROOT/sbin/init" ] || [ -x "$NEWROOT/usr/sbin/init" ] || {
    umount "$NEWROOT" 2>/dev/null
    losetup -d "$LOOP_DEV" 2>/dev/null
    rescue "image mounted but has no /sbin/init"
}

# --- carry the card into the new root ---------------------------------------
# The new root's shutdown path (vita-loopdetach) needs the card at the same
# path, and vita-boot-confirm needs to write the confirmation there. Move the
# mount rather than remounting: the loop device backing / lives on it.
mkdir -p "$NEWROOT$CARD_MNT"
mount --move "$CARD_MNT" "$NEWROOT$CARD_MNT" 2>/dev/null \
  || log "WARN: could not move the card mount; confirm may fail"

log "switch_root -> Debian (PID 1 = $(readlink -f "$NEWROOT/sbin/init" 2>/dev/null))"
log "if this is the last line you see, the new root did not come up"

# Housekeeping before the exec. /dev must be moved, not unmounted: the loop
# device node lives there and the new root needs it immediately.
mount --move /dev "$NEWROOT/dev" 2>/dev/null
umount /proc 2>/dev/null
umount /sys  2>/dev/null

exec switch_root "$NEWROOT" /sbin/init

# Unreachable if switch_root succeeded. If we are here, the exec itself failed,
# which means the record stays open and the NEXT boot will count it.
log "switch_root FAILED -- falling back"
exec /sbin/init
